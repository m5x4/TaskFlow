# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Supabase ---------------------------------------------------------------
# Supabase dashboard > Project Settings > Database > Connection string.
# Use the SESSION POOLER URI (port 5432), not the transaction pooler (6543):
# the transaction pooler does not support the prepared statements psycopg3 uses.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- Gemini -----------------------------------------------------------------
# aistudio.google.com/apikey — a Google AI Studio key (not a Vertex AI one).
GEMINI_API_KEY=AIza...

# Model used for extraction. The 2.x line is retired for new API keys — use a
# 3.x flash model. gemini-3.5-flash-lite is cheaper and has higher free request
# caps; gemini-3.6-flash is the newest. Pro models are paid-only.
# Run `taskflow doctor` to confirm a name actually works with your key.
GEMINI_MODEL=gemini-3.5-flash

# Requests per minute the scanner will make. THIS IS PER MODEL — on the free
# tier gemini-3.5-flash allows 5/min while gemini-3.5-flash-lite allows 15.
# Setting it above your model's actual limit is what causes scans to die with
# 429 RESOURCE_EXHAUSTED partway through. Check your live quota in AI Studio.
# Set to 0 to disable pacing entirely (paid keys with no per-minute limit).
GEMINI_REQUESTS_PER_MINUTE=15

# Attempts per request, including the first. Retries use exponential backoff
# long enough to outlast a per-minute quota window. Pacing should mean these
# are rarely needed; this is the safety net.
GEMINI_MAX_RETRIES=5

# --- Gmail ------------------------------------------------------------------
# Path to the OAuth client file downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID > Web application).
GMAIL_CREDENTIALS_PATH=credentials.json
# Written by `taskflow auth`; holds the refresh token. Gitignored.
GMAIL_TOKEN_PATH=token.json

# Local port the OAuth consent callback lands on. The client is a Web
# application type, so http://localhost:<this port>/ must be registered as an
# Authorized redirect URI in Google Cloud Console — exactly, trailing slash
# included. Change both together or consent fails with redirect_uri_mismatch.
GMAIL_OAUTH_PORT=8080

# Base Gmail search query. The scanner appends `after:<last scan>` automatically.
# Narrow this if you want — e.g. add `label:website` and label the mail yourself.
GMAIL_QUERY=-in:spam -in:trash -category:promotions

# Max emails pulled per scan, and max characters of body sent to the model.
MAX_EMAILS_PER_SCAN=50
MAX_BODY_CHARS=20000

# How far back the very first scan reaches, in days. Later scans are incremental.
INITIAL_LOOKBACK_DAYS=7

# --- Website repo (optional) -------------------------------------------------
# Absolute path to the website you maintain. Leave blank until the code exists
# locally: extraction and categorization work fine without it, and file
# suggestions switch on the moment you set this.
TARGET_REPO_PATH=
MAX_INDEX_FILES=400
